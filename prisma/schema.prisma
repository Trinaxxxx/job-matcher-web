// Job Matcher (Gemini/web edition) — database schema
// Separate from the local Python/Claude tool. Postgres (Neon on Vercel).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  isGuest      Boolean  @default(false)
  createdAt    DateTime @default(now())

  // Encrypted at rest (see lib/crypto.ts). User brings their own Apify key.
  apifyKeyEnc  String?

  profile      Profile?
  jobs         Job[]
  searchRuns   SearchRun[]
}

// A single background search run. The /api/search route creates one (status
// "queued") and enqueues a job; the queue worker drives it through the stages and
// fills the funnel stats. The UI polls GET /api/search/[runId] for status.
model SearchRun {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // queued | scraping | scoring | reviewing | persisting | done | failed
  status    String   @default("queued")
  // Snapshot of the inputs this run was asked with, so the worker is self-contained.
  params    Json

  // Funnel stats, filled as stages complete. Same shape the route used to return.
  scraped       Int?
  kept          Int?
  outsideRadius Int?
  gated         Int?
  aiReviewed    Int?
  strongFit     Int?
  aiTokens      Int?
  saved         Int?

  error     String?  @db.Text // user-facing message when status = "failed"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
}

// One profile per user: parsed CV text + questionnaire answers + derived strategy.
model Profile {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  cvText      String?  @db.Text
  cvFileName  String?

  // Questionnaire answers (raw JSON) and the derived scoring strategy (JSON).
  answers     Json?
  strategy    Json?

  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
}

// A scraped + scored job, owned by one user.
model Job {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // De-dupe key: hash of (title|company|location) per user.
  fingerprint  String

  title        String
  company      String?
  location     String?
  salary       String?
  url          String?
  source       String?
  description  String?  @db.Text
  postedDate   String?

  score        Int      @default(0)   // 0..100 keyword-scorer score (cheap first pass)
  tier         String?                 // e.g. "Strong match"
  reasons      Json?                   // string[] explaining the keyword score
  aiScored     Boolean  @default(false)

  // Gemini deep-read pass. Only filled for the top keyword-scored roles that
  // were sent to Gemini (see lib/ai.ts). Null = not reviewed by AI.
  aiScore      Int?                    // 0..100 semantic fit from CV + questionnaire + JD
  aiSummary    String?  @db.Text       // one-paragraph "why this fits you" summary

  status       String   @default("New") // New / Interested / Applied / Rejected
  createdAt    DateTime @default(now())

  @@unique([userId, fingerprint])
  @@index([userId, score])
}
