# Copy to .env.local for local dev; set the same vars in Vercel Project Settings.

# Postgres connection string (Neon on Vercel gives you this automatically).
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Secret used to sign login session cookies. Generate: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-string"

# Secret used to encrypt each user's stored Apify key at rest (32+ chars).
# Generate: openssl rand -base64 32
ENCRYPTION_KEY="change-me-to-another-long-random-string"

# Rate limiting (Upstash Redis). Create a free store at upstash.com, or add the
# Upstash integration from the Vercel Marketplace, then paste the REST creds.
# If these are left blank, rate limiting is DISABLED (fine for local dev; set
# them in production so login/signup/search are protected).
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Inngest (background search queue). REQUIRED in production: the signing key lets
# the SDK verify that calls to /api/inngest really come from Inngest, and the
# event key lets the app enqueue runs. Get both from the Inngest dashboard (or
# the Vercel integration). Local dev uses `npx inngest-cli dev` and needs
# neither. If these are missing in production the worker endpoint won't run.
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""

# --- Optional: Gemini deep-read pass ---
# Not required. Leave blank and the app runs on keyword scoring alone. Set it and
# Gemini deep-reads the top keyword-scored JDs against the CV + questionnaire,
# adding a 0-100 aiScore + summary per job. Get a key at aistudio.google.com.
GEMINI_API_KEY=""
# Optional tuning (defaults shown):
# GEMINI_MODEL="gemini-3.5-flash-lite"   # default; try "gemini-3.6-flash" for richer summaries
# GEMINI_REVIEW_MAX_JOBS="25"   # top N keyword-scored roles to deep-read per search
# GEMINI_REVIEW_MIN_SCORE="70"  # min keyword score to qualify for a (paid) read
# Requests paced against the model's RPM limit. The FREE tier allows only ~5
# requests/minute, so keep concurrency low and max-jobs small there, or you'll
# 429 and fall back to keyword-only. On a paid tier (much higher RPM) raise both.
# GEMINI_CONCURRENCY="4"        # max Gemini requests in flight at once (free tier: 2-3)
# GEMINI_MAX_RETRIES="2"        # retries per job on a 429 / rate-limit, with backoff
# Free-tier suggestion: GEMINI_REVIEW_MAX_JOBS="6" + GEMINI_CONCURRENCY="2".
# Global daily spend cap for the SHARED Gemini key, in tokens across all users.
# 0 / unset = disabled (AI pass always runs). Set it in production (with Upstash
# configured) so a burst of guest accounts or a leaked key can't run up an
# unbounded bill — the app falls back to keyword-only once the day's cap is hit.
# This complements (does not replace) a hard billing cap in the Google console.
# GEMINI_DAILY_TOKEN_BUDGET="0"
