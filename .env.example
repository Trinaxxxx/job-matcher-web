# Copy to .env.local for local dev; set the same vars in Vercel Project Settings.

# Postgres connection string (Neon on Vercel gives you this automatically).
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
# Direct (non-pooled) connection, used by Prisma for migrations / db push.
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

# Secret used to sign login session cookies. Generate: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-string"

# Secret used to encrypt each user's stored Apify key at rest (32+ chars).
# Generate: openssl rand -base64 32
ENCRYPTION_KEY="change-me-to-another-long-random-string"

# Rate limiting (Upstash Redis). Create a free store at upstash.com, or add the
# Upstash integration from the Vercel Marketplace, then paste the REST creds.
# If these are left blank, rate limiting is DISABLED (fine for local dev; set
# them in production so login/signup/search are protected).
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# --- Scheduled guest-account cleanup (GDPR/CCPA data hygiene) ---
# REQUIRED in production for the guest reaper. The cron route
# (/api/cron/reap-guests) only runs when the request carries
# `Authorization: Bearer <CRON_SECRET>`; Vercel Cron attaches this header
# automatically once CRON_SECRET is set on the project (see vercel.json). If it
# is unset, the route fails closed (401) and no guests are reaped.
# Generate: openssl rand -base64 32
CRON_SECRET=""
# How many days a guest/demo account lives before the reaper deletes it.
# Optional — defaults to 7 when unset or invalid.
# GUEST_TTL_DAYS="7"

# --- Optional: Gemini deep-read pass ---
# Not required. Leave blank and the app runs on keyword scoring alone. Set it and
# Gemini deep-reads the top keyword-scored JDs against the CV + questionnaire,
# adding a 0-100 aiScore + summary per job. Get a key at aistudio.google.com.
GEMINI_API_KEY=""
# Optional tuning (defaults shown):
# GEMINI_MODEL="gemini-3.5-flash-lite"
# GEMINI_REVIEW_MAX_JOBS="25"      # top N keyword-scored roles to deep-read per search
# GEMINI_REVIEW_MIN_SCORE="70"     # min keyword score to qualify for a (paid) read
# GEMINI_REVIEW_MIN_SCORE_CV="..." # CV-mode variant of the qualifying score
# GEMINI_CONCURRENCY="4"           # max Gemini requests in flight at once
# GEMINI_MAX_RETRIES="2"           # retries per job on a 429, with backoff
# GEMINI_LOG_REASONING=""          # set to log model reasoning server-side (debug)
# GEMINI_DAILY_TOKEN_BUDGET="0"    # 0/unset = disabled; global daily token cap

# --- Optional: other tuning ---
# APIFY_DAILY_SEARCH_BUDGET=""     # per-user daily scrape cap (0/unset = disabled)
# GEOCODER_USER_AGENT=""           # custom User-Agent for the geocoder lookups
